# Database connection URL
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# generate with python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY="your-secret-key-at-least-32-chars-long"

# JWT signing algorithm
ALGORITHM="HS256"

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# generate with python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"; never change it once connections are saved
CONNECTION_ENCRYPTION_KEY="your-fernet-encryption-key-here"

# Groq API key for language model access
GROQ_API_KEY="your-groq-api-key-here"

# model IDs change over time; list the currently available ones with GET https://api.groq.com/openai/v1/models; required
GROQ_MODEL="REPLACE_WITH_A_MODEL_ID_FROM_THE_GROQ_MODELS_LIST"

# model IDs change over time; list the currently available ones with GET https://api.groq.com/openai/v1/models; required
GROQ_FAST_MODEL="REPLACE_WITH_A_MODEL_ID_FROM_THE_GROQ_MODELS_LIST"

# Application display name
APP_NAME="AI SQL Agent"

# Enable application debug mode
DEBUG=false

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Maximum query complexity score
MAX_QUERY_COMPLEXITY=100

# Query timeout in seconds
QUERY_TIMEOUT_SECONDS=30

# Allow write operations
ENABLE_WRITE_OPERATIONS=false

# Allow delete operations
ENABLE_DELETE_OPERATIONS=false

# Allow data definition operations
ENABLE_DDL_OPERATIONS=false

# Enable LangSmith tracing
LANGSMITH_TRACING="false"

# LangSmith endpoint URL
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# LangSmith API key
LANGSMITH_API_KEY="your-langsmith-api-key-here"

# LangSmith project name
LANGSMITH_PROJECT="sql-agent-project"
