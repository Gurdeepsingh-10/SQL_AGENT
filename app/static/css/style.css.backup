/* Neubrutalist / Retro / Sketchy Theme */

:root {
    --bg-color: #f0f0f0;
    --text-color: #1a1a1a;
    --accent-color: #ffcc00;
    /* Vibrant Yellow */
    --secondary-color: #ff6b6b;
    /* Vibrant Red */
    --tertiary-color: #4ecdc4;
    /* Vibrant Teal */
    --border-color: #000000;
    --border-width: 3px;
    --shadow-offset: 5px;
    --font-main: 'Chakra Petch', sans-serif;
    --font-mono: 'Space Mono', monospace;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    font-family: var(--font-main);
    margin: 0;
    padding: 20px;
    line-height: 1.6;
}

/* Typography */
h1,
h2,
h3 {
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 20px;
}

h1 {
    font-size: 3.5rem;
    text-shadow: 3px 3px 0px var(--accent-color);
}

/* Layout */
.container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 30px;
}

/* Card Style (Sketchy Border) */
.card {
    background: white;
    border: var(--border-width) solid var(--border-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px 0px var(--border-color);
    padding: 20px;
    margin-bottom: 20px;
    transition: transform 0.1s;
    border-radius: 2px;
    /* Slight radius */
}

.card:hover {
    transform: translate(-2px, -2px);
    box-shadow: calc(var(--shadow-offset) + 2px) calc(var(--shadow-offset) + 2px) 0px 0px var(--border-color);
}

/* tables */
.table-container {
    overflow-x: auto;
    margin-top: 1rem;
    border: var(--border-width) solid var(--text-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--text-color);
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    background: white;
}

th,
td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 2px solid var(--text-color);
    border-right: 2px solid var(--text-color);
}

th {
    background-color: var(--primary-color);
    font-weight: 700;
    text-transform: uppercase;
}

tr:last-child td {
    border-bottom: none;
}

td:last-child,
th:last-child {
    border-right: none;
}

/* Utilities */
.truncate-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    font-size: 0.8rem;
    opacity: 0.7;
}

.blink {
    animation: blink 1s step-end infinite;
}

@keyframes blink {
    50% {
        opacity: 0;
    }
}

/* Sidebar */
.sidebar {
    grid-column: 1;
}

.main-content {
    grid-column: 2;
}

/* Inputs & Buttons */
input,
select,
textarea {
    width: 100%;
    padding: 15px;
    border: var(--border-width) solid var(--border-color);
    background: white;
    font-family: var(--font-mono);
    font-size: 1rem;
    margin-bottom: 15px;
    box-shadow: 3px 3px 0px 0px rgba(0, 0, 0, 0.1);
    box-sizing: border-box;
}

input:focus,
textarea:focus {
    outline: none;
    background-color: #fff9db;
    /* Light yellow */
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px 0px var(--border-color);
}

button {
    background-color: var(--accent-color);
    color: black;
    border: var(--border-width) solid var(--border-color);
    padding: 15px 30px;
    font-family: var(--font-main);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.2rem;
    cursor: pointer;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0px 0px var(--border-color);
    transition: all 0.1s;
}

button:hover {
    transform: translate(-2px, -2px);
    box-shadow: calc(var(--shadow-offset) + 2px) calc(var(--shadow-offset) + 2px) 0px 0px var(--border-color);
}

button:active {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px 0px var(--border-color);
}

button.secondary {
    background-color: var(--secondary-color);
}

/* Chat Interface */
.chat-window {
    height: 600px;
    display: flex;
    flex-direction: column;
}

.chat-history {
    flex-grow: 1;
    overflow-y: auto;
    border-bottom: var(--border-width) solid var(--border-color);
    margin-bottom: 20px;
    padding-right: 10px;
    background-image: radial-gradient(#000 1px, transparent 1px);
    background-size: 20px 20px;
    /* Dot pattern */
    background-color: #fff;
}

.message {
    margin-bottom: 20px;
    padding: 15px;
    border: 2px solid var(--border-color);
    max-width: 80%;
    position: relative;
}

.message.user {
    margin-left: auto;
    background-color: var(--tertiary-color);
    border-radius: 15px 15px 0 15px;
    box-shadow: 4px 4px 0px 0px var(--border-color);
}

.message.agent {
    margin-right: auto;
    background-color: white;
    border-radius: 15px 15px 15px 0;
    box-shadow: -4px 4px 0px 0px var(--border-color);
}

.message-content pre {
    background: #eee;
    padding: 10px;
    border: 1px solid #000;
    overflow-x: auto;
    font-family: var(--font-mono);
}

/* Connection List */
.connection-item {
    padding: 10px;
    border-bottom: 2px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.connection-item .conn-info {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
}

.connection-item:hover {
    background-color: #eee;
}

.connection-item.active {
    background-color: var(--accent-color);
    font-weight: bold;
}

.delete-btn {
    background-color: var(--secondary-color);
    color: white;
    border: 2px solid var(--border-color);
    padding: 5px 10px;
    font-size: 1.2rem;
    font-weight: bold;
    cursor: pointer;
    line-height: 1;
    min-width: 30px;
    box-shadow: 2px 2px 0px var(--border-color);
}

.delete-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px var(--border-color);
}

.delete-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 0px 0px 0px var(--border-color);
}

/* Auth Overlay */
.auth-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

.auth-box {
    width: 400px;
    background: var(--bg-color);
}

/* Utilities */
.hidden {
    display: none !important;
}

.badge {
    display: inline-block;
    padding: 2px 8px;
    border: 2px solid black;
    font-size: 0.8rem;
    font-weight: bold;
    text-transform: uppercase;
    background: white;
}

/* Scrollbar */
::-webkit-scrollbar {
    width: 12px;
}

::-webkit-scrollbar-track {
    background: #f0f0f0;
    border-left: 2px solid black;
}

::-webkit-scrollbar-thumb {
    background: black;
    border: 2px solid #f0f0f0;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--accent-color);
}